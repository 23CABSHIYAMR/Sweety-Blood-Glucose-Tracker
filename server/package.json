{
  "name": "sweety-server",
  "version": "1.0.0",
  "description": "Backend API for Sweety - Blood Glucose Tracker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/scripts/seed.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "diabetes",
    "tracker",
    "blood-glucose",
    "express",
    "postgresql"
  ],
  "author": "Shiyam",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "pg-mem": "^3.0.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
