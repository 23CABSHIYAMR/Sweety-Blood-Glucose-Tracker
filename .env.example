# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Either provide DATABASE_URL or individual PG* variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sweety_db

# Authentication
JWT_SECRET=sweety_jwt_secret_token_change_in_production_123456
JWT_EXPIRES_IN=7d

# Client Configuration (CORS)
CLIENT_URL=http://localhost:5173
