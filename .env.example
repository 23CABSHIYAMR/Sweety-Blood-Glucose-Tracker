# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Either provide DATABASE_URL or individual PG* variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sweety_db

# Authentication (Dual-token JWT architecture)
JWT_SECRET=sweety_legacy_jwt_secret_123456
JWT_ACCESS_SECRET=sweety_access_secret_change_in_production_123456
JWT_REFRESH_SECRET=sweety_refresh_secret_change_in_production_789012
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Client Configuration (CORS)
CLIENT_URL=http://localhost:5173

